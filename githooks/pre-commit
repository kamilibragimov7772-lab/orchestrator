#!/bin/sh
# Orchestrator stack for Claude Code. Author: @kamil_ibrgmv - https://instagram.com/kamil_ibrgmv
# Validate the index snapshot. Missing Python blocks commit; it is not a pass.
root=$(git rev-parse --show-toplevel) || exit 1
if [ -n "$ORCHESTRATOR_PYTHON" ]; then
  "$ORCHESTRATOR_PYTHON" "$root/tools/pre_commit.py"
elif command -v python3 >/dev/null 2>&1; then
  python3 "$root/tools/pre_commit.py"
elif command -v py >/dev/null 2>&1; then
  py -3 "$root/tools/pre_commit.py"
elif command -v python >/dev/null 2>&1; then
  python "$root/tools/pre_commit.py"
else
  echo "pre-commit: Python missing; validation NOT CHECKED, commit blocked" >&2
  exit 1
fi
