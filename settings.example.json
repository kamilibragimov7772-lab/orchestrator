{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "<ABSOLUTE_PYTHON_EXECUTABLE>",
            "args": [
              "<STACK_ROOT>/tools/guard.py",
              "secret"
            ],
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "<ABSOLUTE_PYTHON_EXECUTABLE>",
            "args": [
              "<STACK_ROOT>/tools/guard.py",
              "risk"
            ],
            "timeout": 15
          }
        ]
      }
    ]
  }
}
